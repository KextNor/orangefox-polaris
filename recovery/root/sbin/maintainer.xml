<?xml version="1.0"?>
<recovery>
	<pages>
		<page name="maintainer">
			<action>
				<action function="set">nav_panel_id=3</action>
			</action>

			<template name="base"/>

			<!-- 维护者头像 -->
			<image>
				<placement x="540" y="350" placement="4"/>
				<image filename="/sbin/maintainer.png"/>
			</image>

			<!-- 维护者名称 -->
			<text>
				<font color="#FFFFFF" size="52"/>
				<placement x="540" y="720" placement="4"/>
				<text>ZiLing_Fox</text>
			</text>

			<!-- 副标题 -->
			<text>
				<font color="#B0BEC5" size="32"/>
				<placement x="540" y="800" placement="4"/>
				<text>OrangeFox Maintainer</text>
			</text>

			<!-- 分隔线 -->
			<image>
				<placement x="120" y="880" w="840" h="2"/>
				<image resource="slider_line"/>
			</image>

			<!-- 设备信息 -->
			<text>
				<font color="#FFFFFF" size="36"/>
				<placement x="540" y="960" placement="4"/>
				<text>Xiaomi Mi Mix 2S (polaris)</text>
			</text>

			<text>
				<font color="#B0BEC5" size="28"/>
				<placement x="540" y="1020" placement="4"/>
				<text>OrangeFox Recovery R12</text>
			</text>

			<!-- 描述 -->
			<text>
				<font color="#78909C" size="26"/>
				<placement x="540" y="1120" placement="4"/>
				<text>Built with official OrangeFox R12 source</text>
			</text>

			<!-- 感谢信息 -->
			<text>
				<font color="#546E7A" size="24"/>
				<placement x="540" y="1200" placement="4"/>
				<text>Thanks to OrangeFox Team &amp; all contributors</text>
			</text>

			<!-- 返回按钮 -->
			<action>
				<touch key="back"/>
				<action function="page">advanced</action>
			</action>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>
		</page>
	</pages>
</recovery>
